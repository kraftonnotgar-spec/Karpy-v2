{
  "name": "karpy/platform",
  "description": "KARPy platform core, mapped from Botble's Laravel core into FastAPI.",
  "type": "project",
  "require": {
    "python": ">=3.11",
    "fastapi": "0.133.0",
    "starlette": "1.3.1",
    "pyjwt": "2.13.0",
    "sqlalchemy": "2.0.41",
    "pydantic": "2.11.3",
    "aiosqlite": "0.21.0",
    "asyncpg": "0.30.0",
    "python-multipart": "0.0.31",
    "pillow": "12.3.0"
  },
  "autoload": {
    "karpy_platform.core.support": "support",
    "karpy_platform.core.acl": "acl",
    "karpy_platform.core.base": "base",
    "karpy_platform.core.dashboard": "dashboard",
    "karpy_platform.core.media": "media",
    "karpy_platform.core.setting": "setting",
    "karpy_platform.core.table": "table",
    "karpy_platform.core.js_validation": "js_validation",
    "karpy_platform.core.chart": "chart",
    "karpy_platform.core.icon": "icon"
  },
  "providers": [
    "karpy_platform.core.base",
    "karpy_platform.core.support",
    "karpy_platform.core.table",
    "karpy_platform.core.acl",
    "karpy_platform.core.dashboard",
    "karpy_platform.core.media",
    "karpy_platform.core.setting",
    "karpy_platform.core.js_validation",
    "karpy_platform.core.chart",
    "karpy_platform.core.icon"
  ],
  "aliases": {
    "BaseHelper": "karpy_platform.core.base.helpers",
    "DashboardMenu": "karpy_platform.core.base.dashboard_menu",
    "Hooks": "karpy_platform.core.base.hooks",
    "RvMedia": "karpy_platform.core.media.rv_media",
    "Setting": "karpy_platform.core.setting.setting_store",
    "Table": "karpy_platform.core.table.table_builder",
    "CoreIcon": "karpy_platform.core.icon.icon_manager"
  }
}
