# KARPy backend - copy to .env and fill in. Never commit .env.
APP_NAME=Karpy
APP_ENV=development
DEBUG=true
APP_URL=http://127.0.0.1:9000
PUBLIC_SITE_URL=http://127.0.0.1:3000
USER_DASHBOARD_URL=http://127.0.0.1:3000
ADMIN_DASHBOARD_URL=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Origin the web/app layer uses to reach this backend from inside the deployment (containers).
# Its hostname is trusted automatically so server-side calls do not hit "Invalid host header".
# INTERNAL_API_ORIGIN=http://my-backend:9000
# Extra hostnames to trust for the Host header (comma-separated bare hostnames).
# INTERNAL_TRUSTED_HOSTS=

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-1
JWT_SECRET=change-me-to-a-long-random-value-2

# PostgreSQL (root docker-compose.yml). Leave unset to use a local SQLite file (karpy.db) for quick experiments.
DATABASE_URL=postgresql+asyncpg://karpy:karpy@127.0.0.1:5432/karpy

# Redis: cache and rate limits (speed plugin)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=false

# RabbitMQ: events between services (docs/SERVICES.md). Leave unset to keep events in the outbox.
# RABBITMQ_URL=amqp://karpy:karpy@127.0.0.1:5672/
RABBITMQ_EXCHANGE=karpy.events

# Signed calls to services written in other languages (services/README.md)
# SERVICE_KEY_ID=backend-1
# SERVICE_SIGNING_SECRET=

# Sign-up rules (admins can override them in settings; plugins via the auth.policy filter)
AUTH_REGISTRATION_OPEN=true
AUTH_PHONE_REQUIRED=true
# Comma-separated ISO country codes, empty = every country
AUTH_PHONE_COUNTRIES=
AUTH_MOBILE_ALLOW_STAFF=false

# First Super Admin created by the installer
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=

# Cookies
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Observability (optional, off by default; docs/INFRASTRUCTURE.md)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=karpy-backend
