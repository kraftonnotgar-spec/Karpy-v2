# Copy to .env (git-ignored) and adjust. EXPO_PUBLIC_* values are inlined into the JS bundle at
# build time: never put a secret here.

# KARPy backend origin (no trailing slash). The app calls
# ${EXPO_PUBLIC_API_BASE_URL}/api/plugins/auth/mobile/v1/...
# Android emulator -> host machine: http://10.0.2.2:8000 ; iOS simulator: http://localhost:8000
# (plain http only works in debug builds; release builds refuse cleartext.)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Display name of the app (home screen label). Bundle ids live in app.json.
EXPO_PUBLIC_APP_NAME=Karpy

# Seconds in the background before the app asks for the PIN / biometrics again.
EXPO_PUBLIC_AUTO_LOCK_SECONDS=60

# Push token kind sent to POST /push-devices: "native" (APNs on iOS, FCM on Android) or "expo"
# (Expo push service; needs an EAS project id in app.json extra.eas.projectId).
EXPO_PUBLIC_PUSH_PROVIDER=native

# Where the crash reporter uploads a report the user agrees to send. Empty = off (default).
EXPO_PUBLIC_CRASH_REPORT_URL=

# development | preview | production (set per profile in eas.json)
EXPO_PUBLIC_APP_ENV=development
