# Backend (KARPy, FastAPI) origin. The web server proxies /api/* there (next.config.ts).
API_ORIGIN=http://127.0.0.1:9000

# Admin console URL segment (default /admin). One segment, e.g. /control-room.
# ADMIN_BASE_PATH=/admin

# Active product in src/products (default "default").
NEXT_PUBLIC_PRODUCT=default

# Brand overrides (otherwise the product manifest's brand is used; neutral default "Karpy").
# NEXT_PUBLIC_APP_NAME=Karpy
# NEXT_PUBLIC_APP_SHORT_NAME=Karpy
# NEXT_PUBLIC_APP_TAGLINE=
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# UI locale; must be one of the product's locales and have a core catalog (en, sw).
# NEXT_PUBLIC_LOCALE=en
